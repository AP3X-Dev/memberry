+  if (!parent.isDirectory() || parent.isSymbolicLink() || await realpath(dirname(absolute)) !== dirname(absolute)) throw new Error('custody');
+  const bytes = canonicalBytes(record); const handle = await open(absolute, fsConstants.O_WRONLY | fsConstants.O_CREAT | fsConstants.O_EXCL | fsConstants.O_NOFOLLOW, 0o600);
+  try { const write = await handle.write(bytes, 0, bytes.length, 0); if (write.bytesWritten !== bytes.length) throw new Error('custody'); await handle.sync(); }
+  finally { await handle.close(); }
+}
+
+async function evaluateHoldout(approval: ApprovedDevelopment, identity: HoldoutIdentity, evaluator: HoldoutEvaluator): Promise<JsonRecord> {
+  const [recallScenarios, precisionScenarios] = await Promise.all([evaluator.load('recall'), evaluator.load('precision')]);
+  if (recallScenarios.length !== 10 || precisionScenarios.length !== 10) throw new Error('metric');
+  const recallReport = await evaluator.compare('recall', recallScenarios); const precisionReport = await evaluator.compare('precision', precisionScenarios);
+  const recallPairs = strictPairs(recallReport).sort((a, b) => a.scenarioId.localeCompare(b.scenarioId) || a.probeId.localeCompare(b.probeId));
+  const precisionPairs = strictPairs(precisionReport).sort((a, b) => a.scenarioId.localeCompare(b.scenarioId) || a.probeId.localeCompare(b.probeId));
+  const identities = [...recallPairs, ...precisionPairs].map((pair) => `${pair.scenarioId}\0${pair.probeId}`);
+  if (new Set(identities).size !== 20 || new Set([...recallPairs, ...precisionPairs].map((pair) => pair.scenarioId)).size !== 20
+    || new Set([...recallPairs, ...precisionPairs].map((pair) => pair.probeId)).size !== 20) throw new Error('metric');
+  const recall = laneSummary(recallReport, 'recall'); const precision = laneSummary(precisionReport, 'precision');
+  for (const report of [recallReport, precisionReport]) {
+    const metrics = report.candidate.metrics;
+    if (metrics.staleLeakRate !== 0 || metrics.isolationLeakRate !== 0 || metrics.duplicateRate !== 0 || metrics.unknownResultRate !== 0) throw new Error('safety');
+  }
+  const measured = evaluator.interval([...recallPairs, ...precisionPairs]);
+  const efficiency = { outcome: measured.outcome, pairedProbes: measured.pairedProbes, resamples: measured.resamples, level: measured.level,
+    seed: measured.seed, point: measured.point, lower: measured.lower, upper: measured.upper, oneSidedLower: measured.oneSidedLower };
+  const receipt = { schemaVersion: '1', decision: 'passed', ...identity, approvalSha256: sha256(canonicalBytes(approval as unknown as JsonRecord)),
+    datasetId: 'memberry-g2-holdout-holdout', split: 'holdout', controlAdapterId: CONTROL_ID, candidateAdapterId: CANDIDATE_ID,
+    recall, precision, efficiency, safety: { staleLeakRate: 0, isolationLeakRate: 0, duplicateRate: 0, unknownResultRate: 0 } };
+  return validateHoldoutReceipt(receipt);
+}
+
+export async function runInjectedHoldoutForTest(
+  approval: ApprovedDevelopment,
+  identity: HoldoutIdentity,
+  evaluator: HoldoutEvaluator,
+  receiptPath: string,
+): Promise<'passed' | 'failed'> {
+  try { await publishClosed(receiptPath, await evaluateHoldout(approval, identity, evaluator)); return 'passed'; }
+  catch (error) {
+    const marker = error instanceof Error ? error.message : '';
+    const tombstone = { schemaVersion: '1', decision: 'failed', failureClass: marker === 'safety' ? 'safety' : marker === 'metric' ? 'metric' : 'custody',
+      stage: marker === 'safety' ? 'safety-policy' : marker === 'metric' ? 'qualification' : 'custody', ...identity };
+    try { await publishClosed(receiptPath, tombstone); } catch { /* collision or partial receipt stays untouched */ }
+    return 'failed';
+  }
+}
+
+async function runHoldoutQualification(): Promise<void> {
+  const identity = holdoutIdentity(); const receiptPath = process.env.RET010_HOLDOUT_RECEIPT_PATH ?? '';
+  try {
+    const approval = await validateCommittedApproval();
+    validateHoldoutPolicy(JSON.parse(await readFile(resolve(HERE, 'holdout-policy.json'), 'utf8')) as unknown);
+    const [{ loadG2HoldoutScenariosForScoring }, { compareRegisteredAdapters }, stats] = await Promise.all([
+      import('../datasets/load-suite.js'), import('../registered-adapters.js'), import('../stats.js'),
+    ]);
+    const policy = { minRecallAtK: 0, minPrecisionAtK: 0, minAnswerCoverage: 0, maxStaleLeakRate: 0,
+      maxIsolationLeakRate: 0, maxDuplicateRate: 0, maxUnknownResultRate: 0, maxQualityRegression: 1 };
+    const evaluator: HoldoutEvaluator = {
+      load: (dimension) => loadG2HoldoutScenariosForScoring(dimension, REPO_ROOT),
+      compare: (dimension, scenarios) => compareRegisteredAdapters({ runId: `ret010-holdout-${dimension}`, controlId: CONTROL_ID,
+        candidateId: CANDIDATE_ID, scenarios: scenarios as any, splits: ['holdout'], policy, repoRoot: REPO_ROOT }),
+      interval: (pairs) => stats.pairedEfficiencyInterval(pairs),
+    };
+    if (await runInjectedHoldoutForTest(approval, identity, evaluator, receiptPath) !== 'passed') throw new Error('metric');
+  } catch (error) {
+    const tombstone = { schemaVersion: '1', decision: 'failed', failureClass: 'custody', stage: 'approval', ...identity };
+    try { await publishClosed(receiptPath, tombstone); } catch { /* a current tombstone or contradiction remains untouched */ }
+    throw error;
+  }
+}
+
+async function cli(): Promise<void> {
+  if (process.argv.length !== 2) throw new Error('custody');
+  await runHoldoutQualification();
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  void cli().catch(() => { process.stderr.write(FAILURE_SENTINEL); process.exitCode = 1; });
+}
