+      controlCoverage: current.probe.metrics.answerCoverage, controlTokens: current.probe.contextTokens ?? 0,
+      candidateCoverage: paired.probe.metrics.answerCoverage, candidateTokens: paired.probe.contextTokens ?? 0,
+      controlResultIds: current.probe.resultIds, candidateResultIds: paired.probe.resultIds };
