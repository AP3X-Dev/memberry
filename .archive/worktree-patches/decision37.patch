+function exactNeo4jWordDescriptor(
+  descriptor: PropertyDescriptor | undefined,
+  known: PropertyDescriptor,
+): descriptor is PropertyDescriptor & { value: unknown } {
+  return descriptor !== undefined
+    && 'value' in descriptor
+    && descriptor.enumerable === known.enumerable
+    && descriptor.configurable === known.configurable
+    && descriptor.writable === known.writable;
+}
